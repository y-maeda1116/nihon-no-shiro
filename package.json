{
  "name": "nihon-no-shiro",
  "version": "0.1.0",
  "description": "日本のお城情報を閲覧・検索できる静的 Web アプリケーション",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "typescript",
    "vite",
    "tailwindcss",
    "castles",
    "japan"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/** index.html",
    "format:check": "prettier --check src/** index.html",
    "fetch-photos": "node scripts/fetch-castle-photos.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
