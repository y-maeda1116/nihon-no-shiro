{
  "name": "ts-template-base",
  "version": "0.0.1",
  "description": "TypeScript template repository for Node.js tool development",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "typescript",
    "template",
    "nodejs"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup --clean && tsc --emitDeclarationOnly --declaration --outDir dist --noEmit false",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**",
    "format:check": "prettier --check src/**",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  }
}
